###################################################################
                                #Setup#
###################################################################

import pandas as pd
import statsmodels.api as sm

from statsmodels.formula.api import ols

input_file = r"C:\Users\UxVeg\OneDrive\Documents\UCONNFOOTBALLPROJECT.xlsx"

df = pd.read_excel(input_file, sheet_name="Full Data")

###################################################################
                        #Data Selection#
###################################################################

anova_data = df[
    [
        "QB",
        "CLASS",
        "247 RATINGS",
        "STARS",
        "INCHES",
        "WEIGHT",
        "STATE",
        "HOMETOWN",
        "HIGH SCHOOL",
        "HIGH SCHOOL RANK",
        "HIGH SCHOOL TIER",
        "COMMITTED DATE",
        "POSITION RANK",
        "NATIONAL RANK",
        "STATE RANK",
        "COMMITTED SCHOOL",
        "TOP 25 TEAM",
        "SCHOOL CONFERENCE",
        "FBS OR FCS",
        "STRAIGHT LINE DISTANCE (MILES)",
        "DRIVING DISTANCE (MILES)",
        "RECRUIT STATUS"
    ]
].copy()

###################################################################
                    #Numerical Variables#
###################################################################

numerical_variables = [
    "247 RATINGS",
    "INCHES",
    "WEIGHT",
    "HIGH SCHOOL RANK",
    "POSITION RANK",
    "NATIONAL RANK",
    "STATE RANK",
    "STRAIGHT LINE DISTANCE (MILES)",
    "DRIVING DISTANCE (MILES)"
]

###################################################################
                        #Clean Numeric Data#
###################################################################

for column in numerical_variables:

    anova_data[column] = pd.to_numeric(
        anova_data[column],
        errors="coerce"
    )

###################################################################
                    #Categorical Variables#
###################################################################

categorical_variables = [
    "CLASS",
    "STARS",
    "HIGH SCHOOL TIER",
    "TOP 25 TEAM",
    "SCHOOL CONFERENCE",
    "FBS OR FCS",
    "RECRUIT STATUS"
]


###################################################################
                        #ANOVA Function#
###################################################################

def anova_func(data, numerical_variable, categorical_variable):

    test_data = data[
        [numerical_variable, categorical_variable
        ]
    ].dropna().copy()

    group_counts = (
        test_data[categorical_variable]
        .value_counts()
    )

    valid_groups = group_counts[
        group_counts >= 2
    ].index

    test_data = test_data[
        test_data[categorical_variable].isin(valid_groups)
    ]

    if test_data[categorical_variable].nunique() < 2:
        return None

    formula = (
        f'Q("{numerical_variable}") '
        f'~ C(Q("{categorical_variable}"))'
    )

    model = ols(
        formula=formula,
        data=test_data
    ).fit()

    anova_table = sm.stats.anova_lm(
        model,
        typ=2
    )

    total_sum_squares = (
        anova_table["sum_sq"].sum()
    )

    anova_table["ETA SQUARED"] = (
        anova_table["sum_sq"]
        / total_sum_squares
    )

    return anova_table

###################################################################
                    #Run All ANOVA Tests#
###################################################################

import warnings

anova_results = {}

for category in categorical_variables:

    for numerical in numerical_variables:

        test_name = f"{numerical} BY {category}"

        print("\nRunning:", test_name)

        with warnings.catch_warnings(record=True) as caught_warnings:

            warnings.simplefilter("always")

            result = anova_func(
                anova_data,
                numerical,
                category
            )

            if result is not None:

                anova_results[test_name] = result

            if len(caught_warnings) > 0:

                print("WARNING FOUND:")

                for warning in caught_warnings:
                    print(warning.message)
        
###################################################################
                    #ANOVA Summary Table#
###################################################################

anova_summary = []

for test_name, result in anova_results.items():

    numerical, category = test_name.split(" BY ",1)

    f_statistic = result.iloc[0]["F"]
    p_value = result.iloc[0]["PR(>F)"]
    eta_squared = result.iloc[0]["ETA SQUARED"]

    if p_value < 0.05:
        significant = "YES"
    else:
        significant = "NO"

    anova_summary.append(
        {
        "NUMERICAL VARIABLE": numerical,
        "GROUP VARIABLE": category,
        "F STATISTIC": f_statistic,
        "P VALUE": p_value,
        "SIGNIFICANT": significant,
        "ETA SQUARED": eta_squared
        }
    )

anova_summary = pd.DataFrame(anova_summary)

anova_summary = anova_summary.sort_values("P VALUE", ascending=True)

###################################################################
                        #Group Statistics#
###################################################################

group_statistics = []

for category in categorical_variables:

    for numerical in numerical_variables:

        test_data = anova_data[
            [numerical, category]
        ].dropna().copy()

        group_stats = (
            test_data.groupby(category)[numerical]
            .agg(
                [
                    "count",
                    "mean",
                    "median",
                    "std"
                ]
            )
            .reset_index()
        )

        for _, row in group_stats.iterrows():

            group_statistics.append(
                {
                    "NUMERICAL VARIABLE": numerical,
                    "GROUP VARIABLE": category,
                    "GROUP": row[category],
                    "SAMPLE SIZE": row["count"],
                    "MEAN": row["mean"],
                    "MEDIAN": row["median"],
                    "STANDARD DEVIATION": row["std"]
                }
            )

group_statistics = pd.DataFrame(
    group_statistics
)

###################################################################
                #Multivariable Rating Analysis#
###################################################################

rating_model_data = anova_data[
    [
        "247 RATINGS",
        "INCHES",
        "WEIGHT",
        "HIGH SCHOOL RANK",
        "HIGH SCHOOL TIER",
        "CLASS"
    ]
].dropna().copy()

rating_model = ols(
    formula=(
        'Q("247 RATINGS") ~ '
        'Q("INCHES") + '
        'Q("WEIGHT") + '
        'Q("HIGH SCHOOL RANK") + '
        'C(Q("HIGH SCHOOL TIER")) + '
        'C(Q("CLASS"))'
    ),
    data=rating_model_data
).fit()

rating_anova = sm.stats.anova_lm(
    rating_model,
    typ=2
)

###################################################################
                    #Partial Eta Squared#
###################################################################

residual_sum_squares = (
    rating_anova.loc[
        "Residual",
        "sum_sq"
    ]
)

rating_anova["PARTIAL ETA SQUARED"] = (
    rating_anova["sum_sq"]
    / (
        rating_anova["sum_sq"]
        + residual_sum_squares
    )
)

rating_anova.loc[
    "Residual",
    "PARTIAL ETA SQUARED"
] = None

###################################################################
                    #Clean ANOVA Output#
###################################################################

rating_anova = rating_anova.reset_index()

rating_anova = rating_anova.rename(
    columns={
        "index": "VARIABLE",
        "sum_sq": "SUM OF SQUARES",
        "df": "DF",
        "F": "F STATISTIC",
        "PR(>F)": "P VALUE"
    }
)

rating_anova["VARIABLE"] = rating_anova["VARIABLE"].replace(
    {
        'Q("INCHES")': "INCHES",
        'Q("WEIGHT")': "WEIGHT",
        'Q("HIGH SCHOOL RANK")': "HIGH SCHOOL RANK",
        'C(Q("HIGH SCHOOL TIER"))': "HIGH SCHOOL TIER",
        'C(Q("CLASS"))': "CLASS",
        "Residual": "RESIDUAL"
    }
)

###################################################################
                    #Rating Model Summary#
###################################################################

rating_model_summary = pd.DataFrame(
    {
        "STATISTIC": [
            "SAMPLE SIZE",
            "R SQUARED",
            "ADJUSTED R SQUARED"
        ],

        "VALUE": [
            int(rating_model.nobs),
            rating_model.rsquared,
            rating_model.rsquared_adj
        ]
    }
)

###################################################################
                #Compare Rating Models#
###################################################################

rating_models = {}

###################################################################
                    #Model 1 - Both#
###################################################################

model_1 = ols(
    formula=(
        'Q("247 RATINGS") ~ '
        'Q("INCHES") + '
        'Q("WEIGHT") + '
