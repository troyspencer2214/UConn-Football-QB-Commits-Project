rating_models["Both HS Variables"] = model_1

###################################################################
                    #Model 2 - HS Rank#
###################################################################

model_2 = ols(
    formula=(
        'Q("247 RATINGS") ~ '
        'Q("INCHES") + '
        'Q("WEIGHT") + '
        'Q("HIGH SCHOOL RANK") + '
