rating_models["HS Tier Only"] = model_3

###################################################################
                    #Model Comparison#
###################################################################

model_comparison = []

for model_name, model in rating_models.items():

    model_comparison.append(
        {
            "MODEL": model_name,
            "SAMPLE SIZE": int(model.nobs),
            "R SQUARED": model.rsquared,
