from bs4 import BeautifulSoup
import requests
import csv
import os
import time
from geopy.geocoders import Nominatim
from geopy.distance import geodesic


file = open("UConn_Football_Project.csv", "w", newline="", encoding="utf-8")
writer = csv.writer(file)

writer.writerow([
    "QB", "CLASS", "247 RATINGS", "STARS", "RATINGS", "HEIGHT", "WEIGHT", "DUAL THREAT VS POCKET PASSER", "STATE", "HOMETOWN", "HIGH SCHOOL", "HIGH SCHOOL RATING", "HIGH SCHOOL LEVEL", "PROXIMITY TO HOME", "INJURY STATUS", "CONFERENCE", "COMMITTED SCHOOL", "COMMITTED DATE", "POSITION RANK", "NATIONAL RANK", "STATE RANK"
])


for year in [2024, 2025, 2026]:
    
    for page in range(1, 10):
        
        url = f"https://247sport.com/season/{year}/football/commits/?sortby=position&page={page}"
        
        headers = {
            "User-Agent": (
            "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
            "AppleWebKit/537.36 (KHTML, like Gecko) "
            "Chrome/152.0.0.0 Safari/537.36"
            ),
            "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8",
            "Accept-Language": "en-US,en;q=0.9",
        }
        
        response = requests.get(url,headers=headers,timeout=20)
        
        soup = BeautifulSoup(response.text, "html.parser")
        
        print(f"Loaded {year}, page {page}")
        
        
    commit_names = soup.find_all("a", class_="ri-page__name-link")
    rating_boxes = soup.find_all("div", class_="rating")

    print("Names found:", len(commit_names))
    print("Rating boxes found:", len(rating_boxes))

    for name, rating_box in zip(commit_names, rating_boxes):
    
        rating_247 = rating_box.find("span", class_="score")
    
        yellow_stars = rating_box.select("span.icon-starsolid.yellow")
        stars = len(yellow_stars)
    
        writer.writerow([
            name.get_text(strip=True),
            f"{year}",
            rating_247.get_text(strip=True),
            stars
        ])
    time.sleep(1)
file.close()

print(os.path.abspath("UConn_Football_Project.csv"))
